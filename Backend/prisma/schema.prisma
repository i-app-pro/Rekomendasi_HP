generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brands {
  id         Int        @id @default(autoincrement())
  nama       String     @db.VarChar(100)
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime   @default(now()) @updatedAt @db.DateTime(0)
  products   Products[]

  @@map("brands")
}

model Criteria {
  id             Int              @id @default(autoincrement())
  nama           String           @db.VarChar(100)
  atribut        criteria_atribut
  default_bobot  Int
  created_at     DateTime         @default(now()) @db.DateTime(0)
  updated_at     DateTime         @default(now()) @updatedAt @db.DateTime(0)
  criteria_value CriteriaValue[]
  pembobotan     Pembobotan[]

  @@map("criteria")
}

model Founder {
  id          Int      @id @default(autoincrement())
  foto        String?  @db.VarChar(255)
  nama        String   @db.VarChar(100)
  status      String   @db.VarChar(150)
  universitas String   @db.VarChar(150)
  framework   String   @db.VarChar(150)
  username_ig String?  @db.VarChar(100)
  email       String?  @db.VarChar(100)
  github      String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("founders")
}

model CriteriaValue {
  id               Int               @id @default(autoincrement())
  label            String            @db.VarChar(100)
  nilai            Int
  created_at       DateTime          @default(now()) @db.DateTime(0)
  updated_at       DateTime          @default(now()) @updatedAt @db.DateTime(0)
  criteria_id      Int
  criteria         Criteria          @relation(fields: [criteria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "criteria_value_criteria_FK")
  user_preferences UserPreferences[]

  @@index([criteria_id], map: "criteria_value_criteria_FK")
  @@map("criteria_value")
}

model Products {
  id              Int      @id @default(autoincrement())
  nama            String?  @db.VarChar(100)
  harga           Int
  ram             Int
  penyimpanan     Int
  baterai         Int
  update_os       Int
  resolusi_kamera Int
  chipset         String   @db.VarChar(100)
  os              String   @db.VarChar(50)
  tahun_rilis     DateTime @db.DateTime(0)
  fast_charging   String   @db.VarChar(50)
  display         String   @db.VarChar(100)
  foto            String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.DateTime(0)
  updated_at      DateTime @default(now()) @db.DateTime(0)
  brands_id       Int
  brands          Brands   @relation(fields: [brands_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_brands_FK")

  @@index([brands_id], map: "products_brands_FK")
  @@map("products")
}

model RecommendationSession {
  id               Int               @id @default(autoincrement())
  created_at       DateTime          @default(now()) @db.DateTime(0)
  user_id          Int
  pembobotan       Pembobotan[]
  user             user              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recommendation_session_user_FK")
  user_preferences UserPreferences[]

  @@index([user_id], map: "recommendation_session_user_FK")
  @@map("recommendation_session")
}

model Pembobotan {
  id                        Int                   @id @default(autoincrement())
  nilai_bobot               Int
  created_at                DateTime              @default(now()) @db.DateTime(0)
  updated_at                DateTime              @default(now()) @updatedAt @db.DateTime(0)
  recommendation_session_id Int
  criteria_id               Int
  criteria                  Criteria              @relation(fields: [criteria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pembobotan_criteria_FK")
  recommendation_session    RecommendationSession @relation(fields: [recommendation_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pembobotan_recommendation_session_FK")

  @@index([criteria_id], map: "pembobotan_criteria_FK")
  @@index([recommendation_session_id], map: "pembobotan_recommendation_session_FK")
  @@map("pembobotan")
}

model UserPreferences {
  id                        Int                   @id @default(autoincrement())
  created_at                DateTime              @db.DateTime(0)
  updated_at                DateTime              @updatedAt @db.DateTime(0)
  recommendation_session_id Int
  criteria_value_id         Int
  criteria_value            CriteriaValue         @relation(fields: [criteria_value_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_preferences_criteria_value_FK")
  recommendation_session    RecommendationSession @relation(fields: [recommendation_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_preferences_recommendation_session_FK")

  @@index([criteria_value_id], map: "user_preferences_criteria_value_FK")
  @@index([recommendation_session_id], map: "user_preferences_recommendation_session_FK")
  @@map("user_preferences")
}

model user {
  id                     Int                     @id @default(autoincrement())
  nama                   String                  @db.VarChar(100)
  email                  String                  @unique(map: "user_email_UN") @db.VarChar(100)
  password               String                  @db.VarChar(100)
  role                   user_role               @default(customers)
  created_at             DateTime                @default(now()) @db.DateTime(0)
  updated_at             DateTime                @default(now()) @updatedAt @db.DateTime(0)
  recommendation_session RecommendationSession[]
}

view view_alternatif_kriteria_bobot {
  session_id    Int?
  nama_customer String? @db.VarChar(100)
  product_id    Int?
  nama_produk   String? @db.VarChar(100)
  nama_brand    String? @db.VarChar(100)
  c1            Int?
  c2            Int?
  c3            Int?
  c4            Int?
  c5            Int?
  c6            Int?
  bobot_c1      Int?
  bobot_c2      Int?
  bobot_c3      Int?
  bobot_c4      Int?
  bobot_c5      Int?
  bobot_c6      Int?
}

view view_perhitungan_saw {
  session_id    Int?
  nama_customer String?  @db.VarChar(100)
  product_id    Int?
  nama_produk   String?  @db.VarChar(100)
  nama_brand    String?  @db.VarChar(100)
  nilai_saw     Decimal? @db.Decimal(31, 6)
  ranking_saw   BigInt?
}

view view_perhitungan_topsis {
  session_id     Int?
  nama_customer  String? @db.VarChar(100)
  product_id     Int?
  nama_produk    String? @db.VarChar(100)
  nama_brand     String? @db.VarChar(100)
  a_plus_c1      Float?
  a_plus_c2      Float?
  a_plus_c3      Float?
  a_plus_c4      Float?
  a_plus_c5      Float?
  a_plus_c6      Float?
  a_minus_c1     Float?
  a_minus_c2     Float?
  a_minus_c3     Float?
  a_minus_c4     Float?
  a_minus_c5     Float?
  a_minus_c6     Float?
  d_plus         Float?
  d_minus        Float?
  nilai_topsis   Float?
  ranking_topsis BigInt?
}

view view_perhitungan_wp {
  session_id    Int?
  nama_customer String? @db.VarChar(100)
  product_id    Int?
  nama_produk   String? @db.VarChar(100)
  nama_brand    String? @db.VarChar(100)
  nilai_s       Float?
  nilai_v       Float?
  ranking       BigInt?
}

enum criteria_atribut {
  cost
  benefit
}

enum user_role {
  admin
  customers
}
